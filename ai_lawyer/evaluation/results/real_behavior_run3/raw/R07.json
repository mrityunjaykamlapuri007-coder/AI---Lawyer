  "turns": [
    {
      "message": "I ordered a sound bar with a sub-woofer from the seller Appario Retail through Amazon, using a friend's credit card. It was delivered on 15/07/2023 and installed five days later. The sound clarity was poor, so I returned it. It was collected on 24/07/2023 and I was assured the refund would come within five days. Two weeks went by with no refund. When I contacted Amazon customer service, they told me the product had not been received back."
    }
  ],
