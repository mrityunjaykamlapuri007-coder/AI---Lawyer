APP_ENV=local
CORPUS_MODE=fixture
CORPUS_DIR=ai_lawyer/legal_corpus
VECTORSTORE_DIR=ai_lawyer/vectorstore
SQLITE_PATH=ai_lawyer/data/lawyer.db
EVIDENCE_DIR=ai_lawyer/data/evidence

# hash | sentence_transformers
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL_ID=BAAI/bge-large-en-v1.5

RERANKER_ENABLED=false
RERANKER_MODEL_ID=BAAI/bge-reranker-large

RRF_K=60
DENSE_TOP_K=20
SPARSE_TOP_K=20
FUSED_TOP_K=10
FINAL_TOP_K=5
MAX_RETRIEVAL_RETRIES=2
RELEVANCE_MIN_GRADE=2

# fake | openai_compatible | hf_local
LLM_PROVIDER=fake
LLM_MODEL_ID=
LLM_MODEL_PATH=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_S=60

MAX_UPLOAD_MB=5
ALLOWED_ORIGINS=http://localhost:8501
LOG_LEVEL=INFO
DEMO_USER_ID=demo-user
