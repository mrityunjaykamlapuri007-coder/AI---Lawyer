APP_ENV=local
CORPUS_MODE=fixture
CORPUS_DIR=ai_lawyer/legal_corpus
VECTORSTORE_DIR=ai_lawyer/vectorstore
SQLITE_PATH=ai_lawyer/data/lawyer.db
EVIDENCE_DIR=ai_lawyer/data/evidence

# hash = offline test embedder (refused in real mode); remote_http = BGE service on Kaggle
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL_ID=BAAI/bge-large-en-v1.5
# from kaggle/serve_all.ipynb Cell 9; changes every Kaggle session
EMBEDDER_BASE_URL=
EMBEDDER_API_KEY=
EMBEDDER_TIMEOUT_S=60
EMBEDDER_BATCH_SIZE=32
# machine = accept machine_verified corpus rows; human = human_verified only
CORPUS_TRUST_LEVEL=machine

RERANKER_ENABLED=false
RERANKER_MODEL_ID=BAAI/bge-reranker-large

RRF_K=60
DENSE_TOP_K=20
SPARSE_TOP_K=20
FUSED_TOP_K=10
FINAL_TOP_K=5
MAX_RETRIEVAL_RETRIES=2
RELEVANCE_MIN_GRADE=2

# fake | openai_compatible | hf_local
LLM_PROVIDER=fake
# LLM_MODEL wins; LLM_MODEL_ID is kept for older configs
LLM_MODEL=
LLM_MODEL_ID=
LLM_MODEL_PATH=
# Kaggle tunnel: https://<random>.trycloudflare.com/v1 (changes every session)
LLM_BASE_URL=
# a random string chosen by you; must match the server's --api-key
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_S=120
LLM_JSON_SCHEMA_MODE=true
LLM_MAX_RETRIES_HTTP=2
LLM_CALL_LOG=ai_lawyer/evaluation/results/llm_calls.jsonl
LLM_FAILURE_LOG=ai_lawyer/evaluation/results/llm_failures.jsonl

MAX_UPLOAD_MB=5
ALLOWED_ORIGINS=http://localhost:8501
LOG_LEVEL=INFO
DEMO_USER_ID=demo-user
